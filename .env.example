# --- Database (Postgres) ---
# Get a free Postgres database at https://neon.com or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret"

# --- File storage (Cloudflare R2) ---
# Create a bucket at https://dash.cloudflare.com -> R2
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="job-desk-files"

# --- Email (Resend) ---
# Free tier at https://resend.com. If left blank, the app still works, it just won't send emails.
RESEND_API_KEY=""
EMAIL_FROM="Job Desk <portal@yourdomain.com>"

# --- App ---
# The public URL of your deployed app, used in email links.
APP_URL="http://localhost:3000"

# --- First owner account (used once by `npm run db:seed`) ---
OWNER_NAME="Your Name"
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD="choose-a-strong-password"
