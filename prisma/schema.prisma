generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SUPPLIER
  CONTRACTOR
}

enum JobStatus {
  UPLOADED     // raw files uploaded, waiting for supplier
  IN_PROGRESS  // supplier has opened/started the job
  COMPLETED    // supplier has delivered edited files
}

enum FileKind {
  RAW
  EDITED
}

enum NotificationType {
  NEW_JOB
  JOB_COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  jobsCreated  Job[]          @relation("JobCreator")
  jobsAssigned Job[]          @relation("JobSupplier")
  filesUploaded JobFile[]
  notifications Notification[]
  resetTokens   PasswordResetToken[]
}

model Job {
  id            String    @id @default(cuid())
  reference     String    @unique
  title         String
  status        JobStatus @default(UPLOADED)
  dueDate       DateTime?
  rawDownloadedAt DateTime?

  createdById   String?
  createdBy     User?     @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)

  supplierId    String?
  supplier      User?     @relation("JobSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  files         JobFile[]
  notifications Notification[]

  @@index([createdById])
  @@index([supplierId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model JobFile {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  kind         FileKind
  filename     String
  storageKey   String
  sizeBytes    Int?
  contentType  String?

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())

  @@index([jobId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
